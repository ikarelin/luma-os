[org/gnome/desktop/interface]
color-scheme='prefer-light'
gtk-theme='LumaTahoe-Light'
icon-theme='LumaTahoe'
cursor-theme='LumaTahoe'
accent-color='blue'
clock-show-weekday=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/lumaos/MacTahoe-day.jpeg'
picture-uri-dark='file:///usr/share/backgrounds/lumaos/MacTahoe-night.jpeg'
picture-options='zoom'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/lumaos/MacTahoe-night.jpeg'
picture-options='zoom'

[org/gnome/desktop/wm/preferences]
button-layout='close,minimize,maximize:'

[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'user-theme@gnome-shell-extensions.gcampax.github.com', 'blur-my-shell@aunetx']
favorite-apps=['calamares-install-debian.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'chromium.desktop', 'thunderbird.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.Software.desktop', 'org.gnome.Settings.desktop']

[org/gnome/shell/extensions/user-theme]
name='LumaTahoe-Light'

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=true
extend-height=false
dash-max-icon-size=56
show-apps-at-top=true
show-trash=true
show-mounts=false
click-action='minimize-or-previews'
custom-theme-shrink=true
custom-background-color=true
background-color='rgb(255,255,255)'
transparency-mode='FIXED'
background-opacity=0.2

[org/gnome/shell/extensions/blur-my-shell]
brightness=0.95
sigma=30
