#!/bin/bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive
export GIT_TERMINAL_PROMPT=0
export XDG_CURRENT_DESKTOP=GNOME
export XDG_SESSION_TYPE=wayland
export NO_COLOR=1

AURA_REPO="https://github.com/DevWebeloper/aura-glass.git"
AURA_REF="2e39663eb195698ba9881c688e87a8584e3e1275"
AURA_SNAPSHOT="/usr/src/lumaos/upstream/aura-glass"
CACHE_SNAPSHOT="/usr/src/lumaos/upstream/aura-glass-cache"
AURA_SYSTEM_DIR="/usr/share/lumaos/aura-glass"
WORKDIR="/tmp/luma-aura-glass"
SKEL_HOME="/etc/skel"
BUILD_DEPS="git curl ca-certificates unzip sassc dconf-cli dbus-daemon gettext imagemagick libglib2.0-bin libglib2.0-dev-bin libxml2-utils python3 python3-gi python3-pil gir1.2-adw-1"

apt-get update
apt-get install -y --no-install-recommends $BUILD_DEPS

rm -rf "$WORKDIR" "$AURA_SYSTEM_DIR"
mkdir -p "$WORKDIR/bin" "$WORKDIR/aura-glass" "$AURA_SYSTEM_DIR" \
  "$SKEL_HOME/.cache/aura-glass/src"

if [ -x "$AURA_SNAPSHOT/install.sh" ] && [ -d "$AURA_SNAPSHOT/.git" ]; then
  cp -a "$AURA_SNAPSHOT/." "$AURA_SYSTEM_DIR/"
else
  git clone "$AURA_REPO" "$AURA_SYSTEM_DIR"
fi

git -C "$AURA_SYSTEM_DIR" checkout --quiet --detach "$AURA_REF"
git -C "$AURA_SYSTEM_DIR" reset --quiet --hard "$AURA_REF"
git -C "$AURA_SYSTEM_DIR" clean --quiet -fdx

cp -a "$AURA_SYSTEM_DIR/." "$WORKDIR/aura-glass/"
if [ -d "$CACHE_SNAPSHOT" ]; then
  cp -a "$CACHE_SNAPSHOT/." "$SKEL_HOME/.cache/aura-glass/src/"
fi

# Aura's GDM step currently replaces every prepare_deps and
# get_utc_epoch_time symbol in WhiteSur with true. That also renames the
# function definitions and makes WhiteSur's dependency check recursively call
# itself. All required build dependencies are already installed above, so keep
# WhiteSur's original guarded checks intact.
sed -i \
  '/sed -i.*prepare_deps.*true/d; /sed -i.*get_utc_epoch_time.*true/d' \
  "$WORKDIR/aura-glass/lib/steps-gdm.sh"

# On GNOME 48 and 49 Aura Glass normally downloads Open Bar from
# extensions.gnome.org even when its pinned source checkout is already cached.
# Seed that exact supported checkout into the skeleton so image construction is
# not coupled to the extension site's availability.
GNOME_MAJOR="$(gnome-shell --version | sed -n 's/.* \([0-9][0-9]*\)\..*/\1/p')"
OPENBAR_SRC="$SKEL_HOME/.cache/aura-glass/src/openbar"
OPENBAR_DEST="$SKEL_HOME/.local/share/gnome-shell/extensions/openbar@neuromorph"
if [ -n "$GNOME_MAJOR" ] && [ "$GNOME_MAJOR" -lt 50 ] \
  && [ -d "$OPENBAR_SRC/.git" ] \
  && /usr/bin/git -C "$OPENBAR_SRC" cat-file -e 01fb24217e0c^{commit} 2>/dev/null; then
  /usr/bin/git -C "$OPENBAR_SRC" checkout --quiet --detach 01fb24217e0c
  /usr/bin/git -C "$OPENBAR_SRC" reset --quiet --hard 01fb24217e0c
  /usr/bin/git -C "$OPENBAR_SRC" clean --quiet -fdx
  rm -rf "$OPENBAR_DEST"
  mkdir -p "$(dirname "$OPENBAR_DEST")"
  cp -a "$OPENBAR_SRC/openbar@neuromorph" "$OPENBAR_DEST"
  glib-compile-schemas "$OPENBAR_DEST/schemas"
fi

# Aura Glass normally refreshes every pinned checkout before using it. During
# an image build, a complete local cache is preferable to failing on a brief
# GitHub outage. Fetch only when the requested commit is not already present.
cat > "$WORKDIR/bin/git" <<'EOF'
#!/bin/sh
if [ "$#" -ge 4 ] && [ "$1" = "-C" ] && [ "$3" = "fetch" ]; then
  repo="$2"
  ref=""
  for arg in "$@"; do ref="$arg"; done
  if [ "$ref" != "origin" ] && /usr/bin/git -C "$repo" cat-file -e "${ref}^{commit}" 2>/dev/null; then
    exit 0
  fi
fi
exec /usr/bin/git "$@"
EOF

# live-build hooks run as root without a user systemd manager. The files still
# need to be installed into /etc/skel, but starting those services here would
# be both impossible and incorrect.
cat > "$WORKDIR/bin/systemctl" <<'EOF'
#!/bin/sh
exit 0
EOF

# Aura Glass uses sudo only for its optional system-wide GDM step. The hook is
# already root inside the chroot, so execute the requested command directly.
cat > "$WORKDIR/bin/sudo" <<'EOF'
#!/bin/sh
if [ "${1:-}" = "-v" ]; then
  exit 0
fi
exec "$@"
EOF

# Aura applies a per-user Flatpak override. Initializing Flatpak's user repo in
# /etc/skel is not valid during image construction, so defer that one command
# and materialize the equivalent override file after the installer finishes.
cat > "$WORKDIR/bin/flatpak" <<'EOF'
#!/bin/sh
is_override=false
is_user=false
for arg in "$@"; do
  [ "$arg" = "override" ] && is_override=true
  [ "$arg" = "--user" ] && is_user=true
done
if $is_override && $is_user; then
  exit 0
fi
exec /usr/bin/flatpak "$@"
EOF

chmod 0755 \
  "$WORKDIR/bin/git" \
  "$WORKDIR/bin/systemctl" \
  "$WORKDIR/bin/sudo" \
  "$WORKDIR/bin/flatpak"

export HOME="$SKEL_HOME"
export USER=root
export SUDO_USER=root
export PATH="$WORKDIR/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

AURA_STATUS=0
dbus-run-session -- "$WORKDIR/aura-glass/install.sh" \
  --minimal \
  --accent blue \
  --radius-preset rounded \
  --app-transparency 90% \
  --titlebar-button-style minimal \
  --icons colloid-blue \
  --cursors adwaita \
  --font system \
  --no-rounded-blur \
  --no-panel-blur-fix \
  --no-update-check \
  --gdm \
  --no-gdm-monitors \
  --yes </dev/null || AURA_STATUS=$?

if [ "$AURA_STATUS" -ne 0 ]; then
  printf 'Aura Glass installer exited with status %s; validating installed artifacts\n' \
    "$AURA_STATUS" >&2
fi

mkdir -p "$SKEL_HOME/.local/share/flatpak/overrides"
cat > "$SKEL_HOME/.local/share/flatpak/overrides/global" <<'EOF'
[Context]
filesystems=xdg-config/gtk-4.0:ro;xdg-config/gtk-3.0:ro;xdg-data/themes:ro;xdg-data/icons:ro;
EOF

# LumaOS owns theme updates and the login background. Keep the settings app,
# but do not open it automatically or run a privileged wallpaper sync service
# in every user's session.
rm -f \
  "$SKEL_HOME/.config/autostart/aura-glass-open-once.desktop" \
  "$SKEL_HOME/.config/systemd/user/aura-glass-gdm-sync.service" \
  "$SKEL_HOME/.config/systemd/user/aura-glass-update-check.service" \
  "$SKEL_HOME/.config/systemd/user/aura-glass-update-check.timer" \
  "$SKEL_HOME/.local/bin/aura-glass-gdm-sync" \
  "$SKEL_HOME/.local/bin/tahoe-glass-gdm-sync"

printf '%s\n' "$AURA_SYSTEM_DIR" > "$SKEL_HOME/.config/aura-glass/repo-path"
rm -rf "$SKEL_HOME/.cache/aura-glass"

test -f "$SKEL_HOME/.themes/Aura-Glass/gnome-shell/gnome-shell.css"
test -f "$SKEL_HOME/.config/gtk-4.0/gtk.css"
test -d "$SKEL_HOME/.local/share/gnome-shell/extensions/aura-glass-blur@aura-glass.local"
test -d "$SKEL_HOME/.local/share/gnome-shell/extensions/openbar@neuromorph"
test -d "$SKEL_HOME/.local/share/gnome-shell/extensions/blur-my-shell@aunetx"
test -d "$SKEL_HOME/.local/share/gnome-shell/extensions/custom-osd@neuromorph"
test -d "$SKEL_HOME/.local/share/icons/Colloid-Dark"
test -s /usr/share/backgrounds/aura-gdm.png

rm -rf "$WORKDIR" /usr/src/lumaos/upstream
