#!/bin/sh
set -e

export DEBIAN_FRONTEND=noninteractive
export GIT_TERMINAL_PROMPT=0
export HOME=/root
export SUDO_USER=root
export USER=root

WORKDIR="/tmp/luma-mactahoe"
GTK_REPO="https://github.com/vinceliuice/MacTahoe-gtk-theme.git"
ICON_REPO="https://github.com/vinceliuice/MacTahoe-icon-theme.git"
BUILD_DEPS="git ca-certificates sassc libglib2.0-dev-bin libglib2.0-dev libxml2-utils imagemagick optipng inkscape"

rm -rf "$WORKDIR"
mkdir -p "$WORKDIR"

apt-get update
apt-get install -y --no-install-recommends $BUILD_DEPS

git clone --depth=1 "$GTK_REPO" "$WORKDIR/MacTahoe-gtk-theme"
git clone --depth=1 "$ICON_REPO" "$WORKDIR/MacTahoe-icon-theme"

(
  cd "$WORKDIR/MacTahoe-icon-theme"
  ./install.sh -d /usr/share/icons -n MacTahoe -t default
)

(
  cd "$WORKDIR/MacTahoe-gtk-theme"
  ./install.sh -d /usr/share/themes -n MacTahoe -o normal -c light -c dark -t all -b --silent-mode --shell
  ./tweaks.sh -g -b /usr/share/backgrounds/lumaos/MacTahoe-night.jpeg -c Dark -t blue --silent-mode
)

link_theme() {
  link_name="$1"
  shift
  for theme in "$@"; do
    if [ -d "/usr/share/themes/$theme/gtk-3.0" ]; then
      ln -sfn "$theme" "/usr/share/themes/$link_name"
      return 0
    fi
  done
  echo "None of the supported MacTahoe theme directories were found for $link_name." >&2
  exit 1
}

link_theme LumaTahoe \
  MacTahoe-Light-blue MacTahoe-Light MacTahoe
link_theme LumaTahoe-Light \
  MacTahoe-Light-blue MacTahoe-Light MacTahoe
link_theme LumaTahoe-Dark \
  MacTahoe-Dark-blue MacTahoe-Dark MacTahoe-dark

for accent in default blue purple pink red orange yellow green grey; do
  if [ "$accent" = "default" ]; then
    link_theme LumaTahoe-Accent-default-Light MacTahoe-Light MacTahoe
    link_theme LumaTahoe-Accent-default-Dark MacTahoe-Dark MacTahoe-dark
  else
    link_theme "LumaTahoe-Accent-$accent-Light" \
      "MacTahoe-Light-$accent"
    link_theme "LumaTahoe-Accent-$accent-Dark" \
      "MacTahoe-Dark-$accent"
  fi
done

for icons in MacTahoe MacTahoe-light MacTahoe-blue MacTahoe-blue-light; do
  if [ -d "/usr/share/icons/$icons" ]; then
    ln -sfn "$icons" /usr/share/icons/LumaTahoe
    break
  fi
done

if [ ! -e /usr/share/icons/LumaTahoe ]; then
  echo "MacTahoe icon theme was installed, but no supported icon directory was found." >&2
  exit 1
fi

mkdir -p /etc/skel/.config/gtk-4.0

append_gtk4_accent_fix() {
  css_file="$1"
  [ -f "$css_file" ] || return 0

  cat >> "$css_file" <<'EOF'

/* LumaOS GNOME accent-color compatibility for GNOME Control Center/libadwaita. */
* {
  --blue-3: #3584e4;
  --teal-3: #2190a4;
  --green-3: #33d17a;
  --yellow-3: #f6d32d;
  --orange-3: #ff7800;
  --red-3: #e01b24;
  --pink-3: #d56199;
  --purple-3: #9141ac;
  --slate-3: #6f8396;
  --standalone-color-oklab: l a b;
  --accent-blue: #3584e4;
  --accent-teal: #2190a4;
  --accent-green: #33d17a;
  --accent-yellow: #f6d32d;
  --accent-orange: #ff7800;
  --accent-red: #e01b24;
  --accent-pink: #d56199;
  --accent-purple: #9141ac;
  --accent-slate: #6f8396;
}

.blue, button.blue, .accent-button.blue, button.accent-button.blue {
  --accent-bg-color: #3584e4;
  --accent-color: #3584e4;
  background-color: #3584e4;
}
.teal, button.teal, .accent-button.teal, button.accent-button.teal {
  --accent-bg-color: #2190a4;
  --accent-color: #2190a4;
  background-color: #2190a4;
}
.green, button.green, .accent-button.green, button.accent-button.green {
  --accent-bg-color: #33d17a;
  --accent-color: #33d17a;
  background-color: #33d17a;
}
.yellow, button.yellow, .accent-button.yellow, button.accent-button.yellow {
  --accent-bg-color: #f6d32d;
  --accent-color: #f6d32d;
  background-color: #f6d32d;
}
.orange, button.orange, .accent-button.orange, button.accent-button.orange {
  --accent-bg-color: #ff7800;
  --accent-color: #ff7800;
  background-color: #ff7800;
}
.red, button.red, .accent-button.red, button.accent-button.red {
  --accent-bg-color: #e01b24;
  --accent-color: #e01b24;
  background-color: #e01b24;
}
.pink, button.pink, .accent-button.pink, button.accent-button.pink {
  --accent-bg-color: #d56199;
  --accent-color: #d56199;
  background-color: #d56199;
}
.purple, button.purple, .accent-button.purple, button.accent-button.purple {
  --accent-bg-color: #9141ac;
  --accent-color: #9141ac;
  background-color: #9141ac;
}
.slate, button.slate, .accent-button.slate, button.accent-button.slate {
  --accent-bg-color: #6f8396;
  --accent-color: #6f8396;
  background-color: #6f8396;
}

.accent-button.blue, .accent-button.teal, .accent-button.green,
.accent-button.yellow, .accent-button.orange, .accent-button.red,
.accent-button.pink, .accent-button.purple, .accent-button.slate {
  color: #ffffff;
}
EOF
}

for accent in default blue purple pink red orange yellow green grey; do
  for mode in Light Dark; do
    source_theme="/usr/share/themes/LumaTahoe-Accent-$accent-$mode"
    target_mode="$(printf '%s' "$mode" | tr 'A-Z' 'a-z')"
    target_dir="/usr/share/lumaos/gtk-4.0/$target_mode/$accent"
    if [ -d "$source_theme/gtk-4.0" ]; then
      mkdir -p "$target_dir"
      cp -a "$source_theme/gtk-4.0/." "$target_dir/"
      append_gtk4_accent_fix "$target_dir/gtk.css"
      append_gtk4_accent_fix "$target_dir/gtk-dark.css"
    fi
  done
done

if [ -d /usr/share/lumaos/gtk-4.0/light/blue ]; then
  cp -a /usr/share/lumaos/gtk-4.0/light/blue/. /etc/skel/.config/gtk-4.0/
elif [ -d /usr/share/lumaos/gtk-4.0/light/default ]; then
  cp -a /usr/share/lumaos/gtk-4.0/light/default/. /etc/skel/.config/gtk-4.0/
fi

if [ -f /usr/share/lumaos/gtk-4.0/dark/blue/gtk.css ]; then
  cp -a /usr/share/lumaos/gtk-4.0/dark/blue/gtk.css /etc/skel/.config/gtk-4.0/gtk-dark.css
elif [ -f /usr/share/lumaos/gtk-4.0/dark/default/gtk.css ]; then
  cp -a /usr/share/lumaos/gtk-4.0/dark/default/gtk.css /etc/skel/.config/gtk-4.0/gtk-dark.css
fi

append_gtk4_accent_fix /etc/skel/.config/gtk-4.0/gtk.css
append_gtk4_accent_fix /etc/skel/.config/gtk-4.0/gtk-dark.css

ln -sfn MacTahoe-day.jpeg /usr/share/backgrounds/lumaos/default-light.jpeg
ln -sfn MacTahoe-night.jpeg /usr/share/backgrounds/lumaos/default-dark.jpeg

rm -rf "$WORKDIR"
apt-get purge -y --auto-remove git sassc libglib2.0-dev-bin libglib2.0-dev libxml2-utils imagemagick optipng inkscape
